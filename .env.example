# Critiq environment configuration
# Copy to .env and fill in. Never commit .env.

# --- GitHub App ---
# App ID (Settings -> Developer settings -> GitHub Apps)
CRITIQ_GITHUB_APP_ID=
# Private key PEM contents (from the GitHub App) OR path to a PEM file
CRITIQ_GITHUB_APP_PRIVATE_KEY=
# Webhook secret set when creating the GitHub App
CRITIQ_GITHUB_WEBHOOK_SECRET=
# OAuth client id/secret (optional for V1)
CRITIQ_GITHUB_CLIENT_ID=
CRITIQ_GITHUB_CLIENT_SECRET=

# --- LLM (OpenRouter) ---
CRITIQ_OPENROUTER_API_KEY=
CRITIQ_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model identifiers for cheap (classification/context) vs strong (reasoning/synthesis)
CRITIQ_LLM_MODEL_CHEAP=openrouter/auto
CRITIQ_LLM_MODEL_STRONG=openrouter/auto

# --- Infrastructure ---
CRITIQ_DATABASE_URL=postgresql+asyncpg://critiq:critiq@localhost:5432/critiq
CRITIQ_REDIS_URL=redis://localhost:6379/0

# --- Repository intelligence ---
# Directory holding cached repo indexes (built with `critiq-index`)
CRITIQ_REPO_INDEX_DIR=.critiq-index

# --- Team review profiles ---
# Directory of *.yml profile files (repos reference via `profile:` in .critiq.yml)
CRITIQ_PROFILES_DIR=

# --- Feedback learning loop ---
# Adjust finding confidence from historical accept/reject/resolve signals
CRITIQ_CONFIDENCE_CALIBRATION=true

# --- Server ---
CRITIQ_APP_HOST=0.0.0.0
CRITIQ_APP_PORT=8000

# --- Operations (optional) ---
CRITIQ_LOG_LEVEL=info
